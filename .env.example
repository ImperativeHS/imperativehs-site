# Copy to `.dev.vars` for local development. In production these are set as
# secrets on the Cloudflare Worker (dashboard or `npx wrangler secret put NAME`).
#
# With RESEND_API_KEY unset, form submissions are logged to the dev console
# instead of emailed (dev only — production refuses to accept submissions).

RESEND_API_KEY=
FORM_TO_EMAIL=info@imperativehs.com
FORM_FROM_EMAIL=Imperative Healthcare Website <forms@imperativehs.com>

# Optional: Cloudflare Turnstile (spam protection). Set both to enable.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
