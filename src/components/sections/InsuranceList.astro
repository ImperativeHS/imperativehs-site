---
import Icon from '@/components/ui/Icon.astro';
import { insurancePlans } from '@/config/insurance';

interface Props {
  columns?: 2 | 3;
}

const { columns = 3 } = Astro.props;
---

<ul class:list={['grid gap-4 sm:grid-cols-2', columns === 3 && 'lg:grid-cols-3']}>
  {insurancePlans.map((plan) => (
    <li class="flex items-start gap-4 border-l-4 border-magenta bg-white px-5 py-4 shadow-[0_2px_12px_rgb(0_0_0/0.06)]">
      <Icon name="circle-check" class="mt-1 size-5 text-sky-dark" />
      <span>
        <span class="block font-heading text-xl text-purple uppercase">{plan.name}</span>
        {plan.note && <span class="block text-[15px] font-light">{plan.note}</span>}
      </span>
    </li>
  ))}
</ul>
