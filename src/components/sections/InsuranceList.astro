---
import { insurancePlans } from '@/config/insurance';

interface Props {
  columns?: 1 | 2;
}

const { columns = 2 } = Astro.props;
---

<ul class:list={['border-t border-line', columns === 2 && 'sm:grid sm:grid-cols-2 sm:gap-x-10']}>
  {insurancePlans.map((plan) => (
    <li class="border-b border-line py-4">
      <span class="block text-lg text-ink">{plan.name}</span>
      {plan.note && <span class="block text-sm text-muted">{plan.note}</span>}
    </li>
  ))}
</ul>
