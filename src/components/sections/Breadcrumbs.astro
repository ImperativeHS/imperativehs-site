---
export interface Crumb {
  name: string;
  path: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <span aria-hidden="true" class="text-line">
            /
          </span>
        )}
        {i === items.length - 1 ? (
          <span aria-current="page" class="line-clamp-1 text-ink">
            {item.name}
          </span>
        ) : (
          <a href={item.path} class="transition-colors hover:text-brand-700">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
