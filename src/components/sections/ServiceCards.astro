---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { getServices, servicePath } from '@/lib/content';

interface Props {
  /** Service id to leave out (e.g. the current page). */
  exclude?: string;
  headingLevel?: 'h2' | 'h3';
}

const { exclude, headingLevel: Heading = 'h3' } = Astro.props;

const services = (await getServices()).filter((s) => s.id !== exclude);
// Purple and magenta alternate in a checkerboard, like the original home page blocks.
const isPurple = (i: number) => (Math.floor(i / 2) + i) % 2 === 0;
// An odd one out at the end spans the full width.
const spansRow = (i: number) => services.length % 2 === 1 && i === services.length - 1;
---

<ul class="grid md:grid-cols-2">
  {services.map((s, i) => (
    <li
      class:list={[
        'flex flex-col items-center px-6 py-14 text-center text-white sm:px-12 lg:px-[72px] lg:py-[88px]',
        isPurple(i) ? 'bg-purple' : 'bg-magenta',
        spansRow(i) && 'md:col-span-2',
      ]}
    >
      <Image
        src={s.data.image}
        alt={s.data.imageAlt}
        widths={[480, 720, 1000]}
        sizes="(min-width: 768px) 576px, 100vw"
        class="aspect-[16/9] w-full max-w-[576px] object-cover"
      />
      <Heading class="mt-8 text-[30px] font-light tracking-[0.02em] sm:text-[34px]">
        {s.data.shortTitle}
      </Heading>
      <span
        class:list={['mt-4 block h-[3px] w-12', isPurple(i) ? 'bg-magenta' : 'bg-purple']}
        aria-hidden="true"
      ></span>
      <p class="mt-6 max-w-md text-[17px] font-light text-white/95">{s.data.summary}</p>
      <Button
        href={servicePath(s)}
        variant={isPurple(i) ? 'magenta' : 'purple'}
        size="lg"
        spaced
        class="mt-8"
        aria-label={`Learn more about ${s.data.shortTitle}`}
      >
        Learn more
      </Button>
    </li>
  ))}
</ul>
