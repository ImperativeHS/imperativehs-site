---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  /** Magenta Oswald line in the grey band (the original site's page taglines). */
  tagline?: string;
  /** Intro paragraph in the grey band. */
  lead?: string;
  breadcrumbs?: Crumb[];
}

const { title, tagline, lead, breadcrumbs } = Astro.props;
const hasBand = Boolean(tagline || lead || Astro.slots.has('default'));
---

<section class="bg-purple text-white">
  <div class="container-page py-14 text-center sm:py-20">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <h1 class="font-title text-[34px] leading-tight font-extrabold sm:text-[52px]">{title}</h1>
  </div>
</section>

{hasBand && (
  <section class="bg-mist">
    <div class="container-page py-10 text-center sm:py-12">
      {tagline && (
        <p class="font-heading text-2xl font-light text-magenta-dark uppercase sm:text-[28px]">{tagline}</p>
      )}
      {lead && (
        <p class:list={['mx-auto max-w-4xl text-lg font-light sm:text-xl', tagline && 'mt-4']}>{lead}</p>
      )}
      {Astro.slots.has('default') && (
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
          <slot />
        </div>
      )}
    </div>
  </section>
)}
