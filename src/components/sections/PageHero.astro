---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  kicker?: string;
  breadcrumbs?: Crumb[];
}

const { title, lead, kicker, breadcrumbs } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-page pt-10 pb-14 sm:pt-14 sm:pb-20">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    {kicker && <p class="kicker mb-4">{kicker}</p>}
    <h1 class="max-w-4xl animate-rise text-[2.75rem] leading-[1.05] sm:text-6xl">{title}</h1>
    {lead && (
      <p class="mt-6 max-w-2xl animate-rise text-lg text-muted [animation-delay:80ms] sm:text-xl">{lead}</p>
    )}
    {Astro.slots.has('default') && (
      <div class="mt-9 flex animate-rise flex-wrap items-center gap-x-6 gap-y-3 [animation-delay:160ms]">
        <slot />
      </div>
    )}
  </div>
</section>
