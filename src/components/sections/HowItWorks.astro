---
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const steps = [
  {
    title: 'Reach out',
    body: 'Call us or send a short appointment request online. You don’t need a referral to get started.',
  },
  {
    title: 'We’ll call you back',
    body: 'Our team learns what you’re looking for, checks your insurance, and finds a time that works.',
  },
  {
    title: 'Your first visit',
    body: 'A licensed provider gets to know you and your goals, and you build a care plan together.',
  },
];
---

<Section tone="tint" labelledby="how-it-works">
  <SectionHeading
    id="how-it-works"
    title="What to expect"
    intro="From your first call, you’ll be met with warmth and respect."
  />
  <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
    {steps.map((step, i) => (
      <li class="border-t border-brand-900/20 pt-6">
        <span class="font-display text-5xl text-brand-700 tabular-nums" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class="mt-4 text-2xl">{step.title}</h3>
        <p class="mt-2 text-muted">{step.body}</p>
      </li>
    ))}
  </ol>
</Section>
