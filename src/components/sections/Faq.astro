---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item) => (
    <details class="group bg-white shadow-[0_2px_12px_rgb(0_0_0/0.06)]">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 font-heading text-xl text-purple uppercase [&::-webkit-details-marker]:hidden">
        {item.question}
        <span
          aria-hidden="true"
          class="text-3xl leading-none font-light text-magenta transition-transform duration-200 group-open:rotate-45"
        >
          +
        </span>
      </summary>
      <p class="px-6 pb-6 font-light">{item.answer}</p>
    </details>
  ))}
</div>
