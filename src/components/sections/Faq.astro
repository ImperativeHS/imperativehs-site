---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-3xl bg-white ring-1 ring-line">
  {items.map((item) => (
    <details class="group px-6 py-1">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
        {item.question}
        <Icon name="chevron-down" class="size-5 text-brand-600 transition-transform group-open:rotate-180" />
      </summary>
      <p class="pb-5 text-muted">{item.answer}</p>
    </details>
  ))}
</div>
