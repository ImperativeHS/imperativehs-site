---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="border-t border-brand-900/20">
  {items.map((item) => (
    <details class="group border-b border-brand-900/20">
      <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 font-display text-xl text-brand-950 [&::-webkit-details-marker]:hidden">
        {item.question}
        <span
          aria-hidden="true"
          class="font-sans text-2xl leading-none text-brand-700 transition-transform duration-200 group-open:rotate-45"
        >
          +
        </span>
      </summary>
      <p class="max-w-2xl pb-6 text-muted">{item.answer}</p>
    </details>
  ))}
</div>
