---
import { Image } from 'astro:assets';
import headshot from '@/assets/images/faramade-eruanga.jpg';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  body?: string;
  /** Show Dr. Eruanga's photo (off on pages that already feature it). */
  showPhoto?: boolean;
}

const {
  title = 'Schedule Appointment',
  body = 'If you need mental health services, don’t wait. Give us a call or request an appointment today, and our team will reach out to find a time that works for you.',
  showPhoto = true,
} = Astro.props;
---

<section class="overflow-hidden bg-gradient-to-r from-cloud via-white to-blush">
  <div
    class:list={[
      'container-page grid items-end gap-10',
      showPhoto ? 'pt-14 md:grid-cols-[1.2fr_1fr] md:pt-0' : 'py-16',
    ]}
  >
    <div class:list={[showPhoto && 'md:py-20']}>
      <h2 class="text-[38px] font-light tracking-[0.03em] text-purple sm:text-[46px]">{title}</h2>
      <p class="mt-4 max-w-lg text-lg font-light">{body}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <Button href="/request-appointment/" variant="purple" spaced icon="calendar-check">
          Request Appointment
        </Button>
        <a href={site.phone.href} class="font-heading text-xl text-purple hover:text-sky">
          or call {site.phone.display}
        </a>
      </div>
      <p class="mt-6 text-[15px]">
        Not sure where to start?{' '}
        <a
          href={site.screeningUrl}
          target="_blank"
          rel="noopener"
          class="font-semibold text-sky-dark underline underline-offset-2"
        >
          Take our free 3-minute screening
        </a>
        .
      </p>
    </div>
    {showPhoto && (
      <Image
        src={headshot}
        alt="Dr. Faramade Eruanga, Medical Director"
        widths={[360, 720]}
        sizes="(min-width: 768px) 360px, 80vw"
        class="mx-auto w-4/5 max-w-[360px] self-end object-contain md:mt-10 md:w-full"
      />
    )}
  </div>
</section>
