---
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Ready to take the first step?',
  body = 'Call us or request an appointment online. Our team will reach out to find a time that works for you.',
} = Astro.props;
---

<section class="py-14 sm:py-20">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl bg-brand-800 px-6 py-12 text-center sm:px-12 sm:py-16">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 -left-20 size-96 rounded-full bg-brand-600/40 blur-3xl"
      ></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 text-lg text-brand-100">{body}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/request-appointment/" variant="light" size="lg" icon="calendar">
            Request an appointment
          </Button>
          <Button
            href={site.phone.href}
            size="lg"
            icon="phone"
            class="bg-transparent text-white ring-1 ring-white/40 ring-inset hover:bg-white/10"
          >
            Call {site.phone.display}
          </Button>
        </div>
        <p class="mt-6 text-sm text-brand-200">
          Not sure where to start?{' '}
          <a href={site.screeningUrl} class="font-semibold text-white underline underline-offset-2">
            Take our free 3-minute screening
          </a>
          .
        </p>
      </div>
    </div>
  </div>
</section>
