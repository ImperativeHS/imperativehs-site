---
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Ready to take the first step?',
  body = 'Call us or request an appointment online, and our team will reach out to find a time that works for you.',
} = Astro.props;
---

<section class="bg-brand-900 text-brand-100">
  <div class="container-page grid gap-10 py-20 sm:py-24 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16">
    <div>
      <h2 class="text-4xl leading-[1.1] text-white sm:text-5xl">{title}</h2>
      <p class="mt-5 max-w-xl text-lg">{body}</p>
    </div>
    <div class="flex flex-col gap-4 lg:items-end">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/request-appointment/" variant="light" size="lg" icon="arrow-right" iconPosition="end">
          Request an appointment
        </Button>
        <Button
          href={site.phone.href}
          size="lg"
          class="text-white ring-1 ring-white/30 ring-inset hover:bg-white/10 hover:ring-white/60"
        >
          Call {site.phone.display}
        </Button>
      </div>
      <p class="text-sm text-brand-200">
        Not sure where to start?{' '}
        <a
          href={site.screeningUrl}
          class="text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
        >
          Take a free 3-minute screening
        </a>
      </p>
    </div>
  </div>
</section>
