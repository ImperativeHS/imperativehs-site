---
import { fullAddress, site } from '@/config/site';

const label = 'font-heading text-lg font-semibold text-purple uppercase';
---

<aside class="bg-blush p-7">
  <h2 class="text-2xl font-semibold text-magenta">Prefer to talk?</h2>
  <span class="accent-rule" aria-hidden="true"></span>
  <p class="mt-5 font-light">Call during office hours and we’ll help you get started.</p>
  <dl class="mt-6 space-y-5">
    <div>
      <dt class={label}>Call Today</dt>
      <dd>
        <a href={site.phone.href} class="font-heading text-2xl text-sky-dark hover:text-purple">
          {site.phone.display}
        </a>
      </dd>
    </div>
    <div>
      <dt class={label}>Email Address</dt>
      <dd>
        <a href={`mailto:${site.email}`} class="hover:text-purple hover:underline">
          {site.email}
        </a>
      </dd>
    </div>
    <div>
      <dt class={label}>Office Address</dt>
      <dd>
        <a href={site.mapsUrl} class="hover:text-purple hover:underline" rel="noopener" target="_blank">
          <address class="not-italic">{fullAddress}</address>
        </a>
      </dd>
    </div>
    <div>
      <dt class={label}>Hours</dt>
      <dd>
        {site.hoursSummary.map((line) => (
          <span class="block">{line}</span>
        ))}
      </dd>
    </div>
  </dl>
</aside>
