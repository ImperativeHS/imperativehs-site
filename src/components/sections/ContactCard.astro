---
import { fullAddress, site } from '@/config/site';
---

<aside class="rounded-lg bg-sand p-7">
  <h2 class="text-2xl">Prefer to talk?</h2>
  <p class="mt-2 text-muted">Call during office hours and we’ll help you get started.</p>
  <a
    href={site.phone.href}
    class="mt-5 block font-display text-3xl text-brand-800 tabular-nums hover:text-brand-600"
  >
    {site.phone.display}
  </a>
  <dl class="mt-6 space-y-4 border-t border-line pt-5 text-[15px]">
    <div>
      <dt class="text-sm text-muted">Email</dt>
      <dd>
        <a href={`mailto:${site.email}`} class="link">
          {site.email}
        </a>
      </dd>
    </div>
    <div>
      <dt class="text-sm text-muted">Office</dt>
      <dd>
        <a href={site.mapsUrl} class="link" rel="noopener" target="_blank">
          <address class="inline not-italic">{fullAddress}</address>
        </a>
      </dd>
    </div>
    <div>
      <dt class="text-sm text-muted">Hours</dt>
      <dd>
        {site.hours.map((h) => (
          <span class="block">
            {h.label}: {h.value}
          </span>
        ))}
      </dd>
    </div>
  </dl>
</aside>
