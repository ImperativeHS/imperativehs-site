---
import type { HTMLAttributes } from 'astro/types';
import FieldError from './FieldError.astro';

type Props = Omit<HTMLAttributes<'input'>, 'name'> & {
  name: string;
  label: string;
  hint?: string;
  /** Render a <textarea> with this many rows. */
  rows?: number;
  maxlength?: number;
};

const { name, label, hint, rows, required, class: className, id: idProp, ...rest } = Astro.props;
const id = idProp ?? `field-${name}`;
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
const inputClass =
  'mt-2 block w-full rounded-[3px] border-0 bg-field px-4 py-3.5 text-ink ring-1 ring-transparent ring-inset placeholder:text-muted/70 focus:bg-white focus:ring-2 focus:ring-sky aria-invalid:ring-2 aria-invalid:ring-red-600';
---

<div data-field={name} class={className}>
  <label for={id} class="block font-heading text-[17px] font-medium tracking-[0.04em] text-purple uppercase">
    {label}
    {!required && (
      <span class="font-sans text-sm font-normal tracking-normal text-muted normal-case"> (optional)</span>
    )}
  </label>
  {rows ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required}
      aria-describedby={describedBy}
      class={inputClass}
      {...(rest as HTMLAttributes<'textarea'>)}
    />
  ) : (
    <input
      id={id}
      name={name}
      required={required}
      aria-describedby={describedBy}
      class={inputClass}
      {...rest}
    />
  )}
  {hint && (
    <p id={`${id}-hint`} class="mt-1.5 text-sm text-muted">
      {hint}
    </p>
  )}
  <FieldError id={`${id}-error`} />
</div>
