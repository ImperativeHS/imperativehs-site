---
import type { HTMLAttributes } from 'astro/types';
import FieldError from './FieldError.astro';

type Props = Omit<HTMLAttributes<'input'>, 'name'> & {
  name: string;
  label: string;
  hint?: string;
  /** Render a <textarea> with this many rows. */
  rows?: number;
  maxlength?: number;
};

const { name, label, hint, rows, required, class: className, id: idProp, ...rest } = Astro.props;
const id = idProp ?? `field-${name}`;
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
const inputClass =
  'mt-2 block w-full rounded-xl border-0 bg-white px-4 py-3 text-ink shadow-xs ring-1 ring-line ring-inset placeholder:text-muted/70 focus:ring-2 focus:ring-brand-600 aria-invalid:ring-2 aria-invalid:ring-red-600';
---

<div data-field={name} class={className}>
  <label for={id} class="block text-sm font-semibold text-ink">
    {label}
    {!required && <span class="font-normal text-muted"> (optional)</span>}
  </label>
  {rows ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required}
      aria-describedby={describedBy}
      class={inputClass}
      {...(rest as HTMLAttributes<'textarea'>)}
    />
  ) : (
    <input
      id={id}
      name={name}
      required={required}
      aria-describedby={describedBy}
      class={inputClass}
      {...rest}
    />
  )}
  {hint && (
    <p id={`${id}-hint`} class="mt-1.5 text-sm text-muted">
      {hint}
    </p>
  )}
  <FieldError id={`${id}-error`} />
</div>
