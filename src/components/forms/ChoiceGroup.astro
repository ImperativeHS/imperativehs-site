---
import type { Option } from '@/lib/forms/definitions';
import FieldError from './FieldError.astro';

interface Props {
  name: string;
  legend: string;
  options: readonly Option[];
  value?: string;
  required?: boolean;
  class?: string;
}

const { name, legend, options, value, required, class: className } = Astro.props;
const id = `field-${name}`;
---

<fieldset data-field={name} class={className} aria-describedby={`${id}-error`}>
  <legend class="font-heading text-[17px] font-medium tracking-[0.04em] text-purple uppercase">
    {legend}
  </legend>
  <div class="mt-2 flex flex-wrap gap-2">
    {options.map((o, i) => (
      <label class="cursor-pointer">
        <input
          type="radio"
          name={name}
          value={o.value}
          checked={o.value === value}
          required={required && i === 0}
          class="peer sr-only"
        />
        <span class="inline-flex rounded-[3px] bg-field px-4 py-2.5 text-[15px] text-ink transition-colors peer-checked:bg-purple peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-sky hover:bg-blush">
          {o.label}
        </span>
      </label>
    ))}
  </div>
  <FieldError id={`${id}-error`} />
</fieldset>
