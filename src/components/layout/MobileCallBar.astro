---
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
---

<!-- Fixed bottom actions on small screens; the footer reserves space for it (pb-24). -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-line bg-surface/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur sm:hidden">
  <a
    href={site.phone.href}
    class="flex items-center justify-center gap-2 rounded-md py-3 text-[15px] font-medium text-brand-800 ring-1 ring-brand-800/25 ring-inset"
  >
    <Icon name="phone" class="size-4" />
    Call us
  </a>
  <a
    href="/request-appointment/"
    class="flex items-center justify-center gap-2 rounded-md bg-brand-700 py-3 text-[15px] font-medium text-white"
  >
    Request a visit
  </a>
</div>
