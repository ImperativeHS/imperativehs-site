---
import { Image } from 'astro:assets';
import logo from '@/assets/images/logo.png';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { primaryNav, type NavLink } from '@/config/navigation';
import { site } from '@/config/site';
import { getServices, servicePath } from '@/lib/content';

const serviceLinks: NavLink[] = (await getServices()).map((s) => ({
  label: s.data.shortTitle,
  href: servicePath(s),
}));
const nav = primaryNav.map((item) => ({
  ...item,
  children: item.children === 'services' ? serviceLinks : item.children,
}));

const path = Astro.url.pathname;
const isCurrent = (item: (typeof nav)[number]) =>
  item.href === '/'
    ? path === '/'
    : path.startsWith(item.href) || (item.children ?? []).some((c) => path.startsWith(c.href));
const external = (item: NavLink) => (item.external ? { target: '_blank', rel: 'noopener' } : {});
---

<div class="bg-purple text-sm text-white">
  <div class="container-page flex min-h-10 items-center justify-between gap-4 py-2">
    <p class="hidden font-light sm:block">Outpatient mental health &amp; in-home care in {site.county}</p>
    <a
      href={site.screeningUrl}
      target="_blank"
      rel="noopener"
      class="flex items-center gap-1.5 hover:underline"
    >
      Free, confidential mental health screening
      <Icon name="arrow-right" class="size-3.5" />
    </a>
  </div>
</div>

<header class="relative bg-blush">
  <div class="container-page flex items-center justify-between gap-6 py-3 lg:py-4">
    <a href="/" class="shrink-0" aria-label={`${site.name} — home`}>
      <Image
        src={logo}
        alt=""
        class="h-14 w-auto lg:h-[68px]"
        loading="eager"
        widths={[180, 360]}
        sizes="180px"
      />
    </a>

    <dl class="hidden flex-1 justify-end gap-12 text-[15px] leading-snug lg:flex xl:gap-16">
      <div>
        <dt class="font-heading text-lg font-semibold text-purple uppercase">Email Address</dt>
        <dd class="mt-1">
          <a href={`mailto:${site.email}`} class="hover:text-purple">
            {site.email}
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-heading text-lg font-semibold text-purple uppercase">Hours</dt>
        <dd class="mt-1">
          {site.hoursSummary.map((line) => (
            <span class="block">{line}</span>
          ))}
        </dd>
      </div>
      <div>
        <dt class="font-heading text-lg font-semibold text-purple uppercase">Call Today</dt>
        <dd class="mt-1">
          <a href={site.phone.href} class="font-medium hover:text-purple">
            {site.phone.display}
          </a>
        </dd>
      </div>
    </dl>

    <!-- Mobile menu: a native <details> disclosure, so it works without JavaScript. -->
    <details class="group/menu lg:hidden" data-mobile-menu>
      <summary
        class="-mr-2 flex size-12 cursor-pointer list-none items-center justify-center text-magenta [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <Icon name="menu" class="size-8 group-open/menu:hidden" strokeWidth={2.5} />
        <Icon name="x" class="hidden size-8 group-open/menu:block" strokeWidth={2.5} />
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute inset-x-0 top-full z-50 border-t-[3px] border-magenta bg-white shadow-xl"
      >
        <ul class="container-page divide-y divide-line pt-2 pb-28">
          {nav.map((item) => (
            <li class="py-1">
              <a
                href={item.href}
                class="block py-2.5 font-heading text-xl font-light text-purple uppercase"
                {...external(item)}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="mb-2 border-l-2 border-blush pl-4">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block py-1.5 text-[17px] text-ink">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
          <li class="pt-5">
            <Button href="/request-appointment/" variant="sky" class="w-full">
              Schedule Appointment
            </Button>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<nav aria-label="Main" class="sticky top-0 z-40 hidden bg-white shadow-[0_2px_10px_rgb(0_0_0/0.08)] lg:block">
  <div class="container-page flex h-[72px] items-center justify-between gap-6">
    <ul class="flex items-center gap-7 xl:gap-9">
      {nav.map((item) => (
        <li class="group relative">
          <a
            href={item.href}
            class="flex items-center gap-1 py-6 font-heading text-[17px] font-light text-purple uppercase transition-colors hover:text-sky aria-[current=page]:text-sky xl:text-lg"
            aria-current={isCurrent(item) ? 'page' : undefined}
            {...external(item)}
          >
            {item.label}
            {item.children && (
              <Icon
                name="chevron-down"
                class="size-3.5 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
              />
            )}
          </a>
          {item.children && (
            <ul class="invisible absolute top-full left-0 w-64 border-t-[3px] border-sky bg-white py-3 opacity-0 shadow-lg transition duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class="block px-5 py-2 text-[15px] text-ink transition-colors hover:bg-blush hover:text-purple"
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <Button href="/request-appointment/" variant="sky" size="sm">
      Schedule Appointment
    </Button>
  </div>
</nav>

<script>
  // Close the mobile menu after following a link or pressing Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
