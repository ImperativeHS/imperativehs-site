---
import Icon from '@/components/ui/Icon.astro';
import { footerNav } from '@/config/navigation';
import { fullAddress, site } from '@/config/site';
import { getServices, servicePath } from '@/lib/content';

const services = await getServices();
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-brand-100">
  <div class="border-b border-white/10 bg-brand-900">
    <div class="container-page flex flex-col gap-2 py-4 text-sm sm:flex-row sm:items-center sm:gap-3">
      <Icon name="life-buoy" class="size-5 text-brand-200" />
      <p>
        <strong class="font-semibold text-white">In crisis?</strong> Call or text{' '}
        <a href={site.crisis.lifeline.href} class="font-semibold text-white underline underline-offset-2">
          {site.crisis.lifeline.display}
        </a>{' '}
        (Suicide &amp; Crisis Lifeline), available 24/7. In an emergency, call{' '}
        <a href={site.crisis.emergency.href} class="font-semibold text-white underline underline-offset-2">
          {site.crisis.emergency.display}
        </a>
        .
      </p>
    </div>
  </div>

  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <p class="font-display text-xl font-semibold text-white">{site.name}</p>
      <p class="mt-3 text-sm leading-relaxed">{site.tagline}</p>
    </div>

    <div>
      <h2 class="font-sans text-sm font-semibold tracking-wide text-white uppercase">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={site.phone.href} class="flex items-center gap-2 hover:text-white">
            <Icon name="phone" class="size-4 text-brand-300" />
            {site.phone.display}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2 hover:text-white">
            <Icon name="mail" class="size-4 text-brand-300" />
            {site.email}
          </a>
        </li>
        <li>
          <a
            href={site.mapsUrl}
            class="flex items-start gap-2 hover:text-white"
            rel="noopener"
            target="_blank"
          >
            <Icon name="map-pin" class="mt-0.5 size-4 text-brand-300" />
            <address class="not-italic">{fullAddress}</address>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-semibold tracking-wide text-white uppercase">Hours</h2>
      <dl class="mt-4 space-y-2 text-sm">
        {site.hours.map((h) => (
          <div>
            <dt class="font-medium text-white">{h.label}</dt>
            <dd>{h.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:col-span-2 lg:col-span-1 lg:grid-cols-1">
      <nav aria-label="Services">
        <h2 class="font-sans text-sm font-semibold tracking-wide text-white uppercase">Services</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {services.map((s) => (
            <li>
              <a href={servicePath(s)} class="hover:text-white hover:underline">
                {s.data.shortTitle}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Footer">
        <h2 class="font-sans text-sm font-semibold tracking-wide text-white uppercase">Quick links</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="container-page py-6 pb-24 text-xs text-brand-300 sm:pb-6">
      © {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
