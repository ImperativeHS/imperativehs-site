---
import { footerNav } from '@/config/navigation';
import { fullAddress, site } from '@/config/site';
import { getServices, servicePath } from '@/lib/content';

const services = await getServices();
const year = new Date().getFullYear();
const heading = 'text-sm font-medium text-brand-300';
const link = 'transition-colors hover:text-white';
---

<footer class="bg-brand-950 text-brand-100">
  <div class="container-page pt-16 pb-12 sm:pt-20">
    <div class="grid gap-10 border-b border-white/10 pb-12 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <p class="font-display text-3xl leading-tight text-white sm:text-4xl">
        Whenever you’re ready, <br class="hidden sm:block" />
        we’re here to listen.
      </p>
      <div class="flex flex-col gap-1 lg:items-end">
        <a href={site.phone.href} class="font-display text-3xl text-white tabular-nums hover:text-brand-200">
          {site.phone.display}
        </a>
        <a href={`mailto:${site.email}`} class={link}>
          {site.email}
        </a>
      </div>
    </div>

    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class={heading}>Visit</h2>
        <a href={site.mapsUrl} class:list={[link, 'mt-3 block']} rel="noopener" target="_blank">
          <address class="not-italic">{fullAddress}</address>
        </a>
      </div>

      <div>
        <h2 class={heading}>Hours</h2>
        <dl class="mt-3 space-y-2">
          {site.hours.map((h) => (
            <div>
              <dt class="text-white">{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <nav aria-label="Services">
        <h2 class={heading}>Services</h2>
        <ul class="mt-3 space-y-1.5">
          {services.map((s) => (
            <li>
              <a href={servicePath(s)} class={link}>
                {s.data.shortTitle}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Footer">
        <h2 class={heading}>More</h2>
        <ul class="mt-3 space-y-1.5">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class={link}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="border-t border-white/10 pt-6 pb-24 text-sm sm:pb-0">
      <p>
        <span class="text-white">In crisis?</span> Call or text{' '}
        <a href={site.crisis.lifeline.href} class="text-white underline underline-offset-4">
          {site.crisis.lifeline.display}
        </a>{' '}
        any time for the Suicide &amp; Crisis Lifeline. In an emergency, call{' '}
        <a href={site.crisis.emergency.href} class="text-white underline underline-offset-4">
          {site.crisis.emergency.display}
        </a>
        .
      </p>
      <p class="mt-3 text-brand-300">
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>
