---
interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  id?: string;
  align?: 'start' | 'center';
  /** For headings on the dark brand background. */
  inverted?: boolean;
  as?: 'h1' | 'h2' | 'h3';
}

const { title, eyebrow, intro, id, align = 'start', inverted = false, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && (
    <p
      class:list={[
        'mb-2 text-sm font-semibold tracking-wide uppercase',
        inverted ? 'text-brand-200' : 'text-sky-brand-700',
      ]}
    >
      {eyebrow}
    </p>
  )}
  <Tag id={id} class:list={['text-3xl font-semibold sm:text-4xl', inverted && 'text-white']}>
    {title}
  </Tag>
  {intro && <p class:list={['mt-4 text-lg', inverted ? 'text-brand-100' : 'text-muted']}>{intro}</p>}
</div>
