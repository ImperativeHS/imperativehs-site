---
interface Props {
  title: string;
  /** Short label above the title. Use sparingly. */
  kicker?: string;
  intro?: string;
  id?: string;
  align?: 'start' | 'center';
  /** For headings on the dark brand background. */
  inverted?: boolean;
  as?: 'h1' | 'h2' | 'h3';
  size?: 'md' | 'lg';
}

const {
  title,
  kicker,
  intro,
  id,
  align = 'start',
  inverted = false,
  as: Tag = 'h2',
  size = 'md',
} = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {kicker && <p class:list={['kicker mb-3', inverted && 'text-brand-200']}>{kicker}</p>}
  <Tag
    id={id}
    class:list={[
      size === 'lg' ? 'text-4xl leading-[1.1] sm:text-5xl' : 'text-3xl leading-tight sm:text-4xl',
      inverted && 'text-white',
    ]}
  >
    {title}
  </Tag>
  {intro && <p class:list={['mt-4 text-lg', inverted ? 'text-brand-100' : 'text-muted']}>{intro}</p>}
</div>
