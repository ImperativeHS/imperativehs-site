---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'sky' | 'purple' | 'magenta' | 'white' | 'outline-white';
type Size = 'sm' | 'md' | 'lg';

type Props = (HTMLAttributes<'a'> & HTMLAttributes<'button'>) & {
  href?: string;
  variant?: Variant;
  size?: Size;
  icon?: IconName;
  /** Wide letter-spacing, like the original site's "CLICK HERE FOR…" buttons. */
  spaced?: boolean;
};

const {
  href,
  variant = 'purple',
  size = 'md',
  icon,
  spaced = false,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const variants: Record<Variant, string> = {
  sky: 'bg-sky text-white hover:bg-sky-dark',
  purple: 'bg-purple text-white hover:bg-purple-dark',
  magenta: 'bg-magenta text-white hover:bg-magenta-dark',
  white: 'bg-white text-purple hover:bg-blush',
  'outline-white': 'text-white ring-2 ring-white/70 ring-inset hover:bg-white hover:text-purple',
};
const sizes: Record<Size, string> = {
  sm: 'px-5 py-2 text-[17px]',
  md: 'px-6 py-3 text-[19px]',
  lg: 'px-6 py-4 text-[17px] sm:px-9 sm:py-5 sm:text-[19px]',
};

const classes = [
  'inline-flex items-center justify-center gap-2.5 rounded-[3px] text-center font-heading font-medium uppercase transition-colors duration-200',
  spaced ? 'tracking-[0.1em] sm:tracking-[0.18em]' : 'tracking-[0.06em]',
  variants[variant],
  sizes[size],
  className,
];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
    {icon && <Icon name={icon} class="size-[1.05em]" />}
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
    {icon && <Icon name={icon} class="size-[1.05em]" />}
  </button>
)}
