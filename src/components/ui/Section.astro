---
interface Props {
  id?: string;
  tone?: 'plain' | 'tint' | 'brand';
  /** Vertical padding. */
  spacing?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Accessible name for the section landmark, when there is no visible heading id. */
  labelledby?: string;
}

const { id, tone = 'plain', spacing = 'md', class: className, labelledby } = Astro.props;

const tones = {
  plain: '',
  tint: 'bg-sand',
  brand: 'bg-brand-900 text-brand-50',
};
const spacings = {
  sm: 'py-12 sm:py-16',
  md: 'py-16 sm:py-24',
  lg: 'py-24 sm:py-32',
};
---

<section id={id} aria-labelledby={labelledby} class:list={[tones[tone], spacings[spacing], className]}>
  <div class="container-page">
    <slot />
  </div>
</section>
