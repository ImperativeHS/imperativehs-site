---
interface Props {
  id?: string;
  tone?: 'white' | 'mist' | 'cloud' | 'blush' | 'purple' | 'magenta';
  /** Vertical padding. */
  spacing?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
  /** Accessible name for the section landmark. */
  labelledby?: string;
}

const { id, tone = 'white', spacing = 'md', class: className, labelledby } = Astro.props;

const tones = {
  white: 'bg-white',
  mist: 'bg-mist',
  cloud: 'bg-cloud',
  blush: 'bg-blush',
  purple: 'bg-purple text-white',
  magenta: 'bg-magenta text-white',
};
const spacings = {
  none: '',
  sm: 'py-12 sm:py-14',
  md: 'py-16 sm:py-20',
  lg: 'py-20 sm:py-28',
};
---

<section id={id} aria-labelledby={labelledby} class:list={[tones[tone], spacings[spacing], className]}>
  <div class="container-page">
    <slot />
  </div>
</section>
