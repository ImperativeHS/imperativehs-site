---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@/styles/global.css';

import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import MobileCallBar from '@/components/layout/MobileCallBar.astro';
import Seo, { type SeoProps } from '@/components/seo/Seo.astro';

type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#55245d" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Imperative Healthcare Services Blog"
      href="/rss.xml"
    />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-brand-700 px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
