---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContactCard from '@/components/sections/ContactCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Faq from '@/components/sections/Faq.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServiceCards from '@/components/sections/ServiceCards.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FeatureRows from '@/components/sections/FeatureRows.astro';
import ScreeningCallout from '@/components/sections/ScreeningCallout.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, servicePath, type Service } from '@/lib/content';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/seo/structured-data';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const path = servicePath(service);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: data.shortTitle, path },
];
const jsonLd = [
  serviceSchema({ name: data.title, description: data.description, path }),
  breadcrumbSchema(crumbs),
  ...(data.faqs.length ? [faqSchema(data.faqs)] : []),
];
---

<BaseLayout title={data.seoTitle} description={data.description} jsonLd={jsonLd}>
  <PageHero title={data.title} lead={data.summary} breadcrumbs={crumbs}>
    <Button href="/request-appointment/" variant="sky" icon="calendar-check">
      Schedule appointment
    </Button>
    <a href={site.phone.href} class="font-heading text-xl text-purple hover:text-sky">
      or call {site.phone.display}
    </a>
  </PageHero>

  {data.highlights.length > 0 && <FeatureRows items={data.highlights} />}

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <article class="prose-ihs prose-lg">
        <Content />
      </article>
      <div class="space-y-8 lg:self-start">
        {data.whoWeServe.length > 0 && (
          <aside class="bg-purple p-7 text-white">
            <h2 class="text-2xl font-semibold">Who We Serve</h2>
            <span class="accent-rule" aria-hidden="true"></span>
            <ul class="mt-5 space-y-2 font-light">
              {data.whoWeServe.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-3 size-1.5 shrink-0 bg-magenta" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </aside>
        )}
        <ContactCard />
      </div>
    </div>
  </Section>

  <ScreeningCallout tone="magenta" />

  {data.faqs.length > 0 && (
    <Section tone="cloud" labelledby="faq-heading">
      <div class="mx-auto max-w-3xl">
        <SectionHeading id="faq-heading" title="Frequently Asked Questions" align="center" rule />
        <div class="mt-10">
          <Faq items={data.faqs} />
        </div>
      </div>
    </Section>
  )}

  <section aria-labelledby="other-services-heading" class="pt-16 sm:pt-20">
    <SectionHeading id="other-services-heading" title="Our Other Services" align="center" class="mb-10" />
    <ServiceCards exclude={service.id} />
  </section>

  <CtaBand />
</BaseLayout>
