---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContactCard from '@/components/sections/ContactCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Faq from '@/components/sections/Faq.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServiceList from '@/components/sections/ServiceList.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, servicePath, type Service } from '@/lib/content';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/seo/structured-data';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const path = servicePath(service);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: data.shortTitle, path },
];
const jsonLd = [
  serviceSchema({ name: data.title, description: data.description, path }),
  breadcrumbSchema(crumbs),
  ...(data.faqs.length ? [faqSchema(data.faqs)] : []),
];
---

<BaseLayout title={data.seoTitle} description={data.description} jsonLd={jsonLd}>
  <PageHero title={data.title} lead={data.summary} breadcrumbs={crumbs}>
    <Button href="/request-appointment/" size="lg" icon="arrow-right" iconPosition="end">
      Request an appointment
    </Button>
    <a href={site.phone.href} class="link text-lg">
      or call {site.phone.display}
    </a>
  </PageHero>

  {data.highlights.length > 0 && (
    <Section spacing="sm">
      <ul
        class:list={[
          'grid gap-x-10 sm:grid-cols-2',
          data.highlights.length % 3 === 0 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
        ]}
      >
        {data.highlights.map((h) => (
          <li class="border-t border-brand-900/20 py-6">
            <h2 class="text-xl">{h.title}</h2>
            <p class="mt-2 text-[15px] text-muted">{h.body}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section spacing="sm" class="pb-20 sm:pb-28">
    <div class="grid gap-14 lg:grid-cols-[1fr_20rem] lg:gap-20">
      <article class="prose-ihs prose-lg max-w-2xl">
        <Content />
      </article>
      <div class="space-y-8 lg:sticky lg:top-28 lg:self-start">
        {data.whoWeServe.length > 0 && (
          <aside>
            <h2 class="text-2xl">Who we serve</h2>
            <ul class="mt-4 border-t border-line">
              {data.whoWeServe.map((item) => (
                <li class="border-b border-line py-3 text-ink">{item}</li>
              ))}
            </ul>
          </aside>
        )}
        <ContactCard />
      </div>
    </div>
  </Section>

  {data.faqs.length > 0 && (
    <Section tone="tint" labelledby="faq-heading">
      <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-20">
        <SectionHeading id="faq-heading" title="Common questions" />
        <Faq items={data.faqs} />
      </div>
    </Section>
  )}

  <Section labelledby="other-services-heading">
    <SectionHeading id="other-services-heading" title="Other ways we can help" />
    <div class="mt-10">
      <ServiceList exclude={service.id} />
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
