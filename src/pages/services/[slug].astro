---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContactCard from '@/components/sections/ContactCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Faq from '@/components/sections/Faq.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServiceCards from '@/components/sections/ServiceCards.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, servicePath, type Service } from '@/lib/content';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/seo/structured-data';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const path = servicePath(service);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: data.shortTitle, path },
];
const jsonLd = [
  serviceSchema({ name: data.title, description: data.description, path }),
  breadcrumbSchema(crumbs),
  ...(data.faqs.length ? [faqSchema(data.faqs)] : []),
];
---

<BaseLayout title={data.seoTitle} description={data.description} jsonLd={jsonLd}>
  <PageHero title={data.title} lead={data.summary} breadcrumbs={crumbs}>
    <Button href="/request-appointment/" size="lg" icon="calendar">
      Request an appointment
    </Button>
    <Button href={site.phone.href} size="lg" variant="secondary" icon="phone">
      Call {site.phone.display}
    </Button>
  </PageHero>

  {data.highlights.length > 0 && (
    <Section spacing="sm">
      <ul class:list={['grid gap-5 sm:grid-cols-2', data.highlights.length % 3 === 0 && 'lg:grid-cols-3']}>
        {data.highlights.map((h) => (
          <li class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-line">
            <span class="flex size-9 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
              <Icon name="check" class="size-5" strokeWidth={2.5} />
            </span>
            <h2 class="mt-4 font-sans text-lg font-semibold text-ink">{h.title}</h2>
            <p class="mt-1.5 text-muted">{h.body}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section spacing="sm">
    <div class="grid gap-12 lg:grid-cols-[1fr_22rem]">
      <article class="prose-ihs prose-lg">
        <Content />
      </article>
      <div class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        {data.whoWeServe.length > 0 && (
          <aside class="rounded-3xl bg-brand-50 p-7 ring-1 ring-brand-100">
            <h2 class="text-xl font-semibold">Who we serve</h2>
            <ul class="mt-4 space-y-3">
              {data.whoWeServe.map((item) => (
                <li class="flex gap-3 text-ink">
                  <Icon name="check" class="mt-1 size-4 text-brand-600" strokeWidth={2.5} />
                  {item}
                </li>
              ))}
            </ul>
          </aside>
        )}
        <ContactCard />
      </div>
    </div>
  </Section>

  {data.faqs.length > 0 && (
    <Section tone="tint" labelledby="faq-heading">
      <div class="mx-auto max-w-3xl">
        <SectionHeading id="faq-heading" title="Frequently asked questions" align="center" />
        <div class="mt-10">
          <Faq items={data.faqs} />
        </div>
      </div>
    </Section>
  )}

  <Section labelledby="other-services-heading">
    <SectionHeading id="other-services-heading" title="Other services" />
    <div class="mt-8">
      <ServiceCards exclude={service.id} />
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
