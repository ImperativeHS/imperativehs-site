---
import CtaBand from '@/components/sections/CtaBand.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServiceList from '@/components/sections/ServiceList.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema } from '@/lib/seo/structured-data';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<BaseLayout
  title="Mental Health & In-Home Care Services"
  description="Outpatient mental health care, psychiatric rehabilitation (PRP), substance use treatment, and in-home RSA services in Hyattsville, MD."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Our services"
    lead="Integrated care for mental health, recovery, and daily living — for children, teens, adults, and families."
    breadcrumbs={crumbs}
  />
  <Section>
    <ServiceList headingLevel="h2" />
  </Section>
  <CtaBand />
</BaseLayout>
