---
import CtaBand from '@/components/sections/CtaBand.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServiceCards from '@/components/sections/ServiceCards.astro';
import ScreeningCallout from '@/components/sections/ScreeningCallout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema } from '@/lib/seo/structured-data';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<BaseLayout
  title="Mental Health & In-Home Care Services"
  description="Outpatient mental health care, psychiatric rehabilitation (PRP), substance use treatment, and in-home RSA services in Hyattsville, MD."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Our Services"
    tagline="Integrated care for mental health, recovery, and daily living"
    lead="Outpatient mental health care, psychiatric rehabilitation, substance use treatment, and in-home support for children, teens, adults, and families."
    breadcrumbs={crumbs}
  />
  <ServiceCards headingLevel="h2" />
  <ScreeningCallout />
  <CtaBand />
</BaseLayout>
