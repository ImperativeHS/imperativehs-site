---
import PageHero from '@/components/sections/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPosts, postPath } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo/structured-data';

const posts = await getPosts();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---

<BaseLayout
  title="Mental Health Blog"
  description="Articles on anxiety, depression, trauma, relationships, recovery, and everyday mental wellness from Imperative Healthcare Services."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Mental health blog"
    lead="Practical guidance on mental health, recovery, and wellness for individuals and families."
    breadcrumbs={crumbs}
  />

  <Section spacing="sm">
    <ul class="border-t border-line">
      {posts.map((post) => (
        <li class="group relative border-b border-line">
          <div class="grid gap-x-10 gap-y-2 py-7 sm:grid-cols-[10rem_1fr]">
            <p class="text-sm text-muted">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="block">{post.data.category}</span>
            </p>
            <div>
              <h2 class="text-2xl leading-snug transition-colors group-hover:text-brand-700">
                <a href={postPath(post)} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 line-clamp-2 max-w-3xl text-muted">{post.data.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
