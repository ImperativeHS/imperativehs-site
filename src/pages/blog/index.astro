---
import PageHero from '@/components/sections/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPosts, postPath } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo/structured-data';

const posts = await getPosts();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---

<BaseLayout
  title="Mental Health Blog"
  description="Articles on anxiety, depression, trauma, relationships, recovery, and everyday mental wellness from Imperative Healthcare Services."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Blog"
    tagline="Mental health, recovery, and wellness"
    lead="Practical guidance on mental health, recovery, and wellness for individuals and families."
    breadcrumbs={crumbs}
  />

  <Section tone="cloud">
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <li class="group relative flex flex-col border-t-4 border-magenta bg-white p-7 shadow-[0_2px_12px_rgb(0_0_0/0.06)] transition-shadow hover:shadow-[0_6px_24px_rgb(0_0_0/0.12)]">
          <h2 class="text-[22px] font-medium text-purple group-hover:text-magenta-dark">
            <a href={postPath(post)} class="after:absolute after:inset-0">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 text-sm text-muted">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> |{' '}
            {post.data.category}
          </p>
          <p class="mt-4 line-clamp-3 flex-1 text-[15.5px]">{post.data.description}</p>
          <span class="mt-5 font-heading tracking-[0.06em] text-sky-dark uppercase">Read more</span>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
