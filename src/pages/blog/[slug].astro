---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Breadcrumbs from '@/components/sections/Breadcrumbs.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPosts, postPath, type Post } from '@/lib/content';
import { articleSchema, breadcrumbSchema } from '@/lib/seo/structured-data';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are sorted newest first; suggest the neighbours as further reading.
    props: { post, related: [posts[i - 1], posts[i + 1]].filter(Boolean) as Post[] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const path = postPath(post);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: data.title, path },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  jsonLd={[articleSchema({ ...data, path }), breadcrumbSchema(crumbs)]}
>
  <Section spacing="sm">
    <article class="mx-auto max-w-2xl">
      <Breadcrumbs items={crumbs} />
      <p class="kicker">{data.category}</p>
      <h1 class="mt-4 text-[2.5rem] leading-[1.1] sm:text-5xl">{data.title}</h1>
      <p class="mt-5 border-b border-line pb-8 text-sm text-muted">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && (
          <>
            · Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
          </>
        )}
      </p>
      <div class="prose-ihs prose-lg mt-10">
        <Content />
      </div>
      <p class="mt-14 rounded-lg bg-sand p-5 text-[15px] text-ink">
        This article is for general information and isn’t a substitute for professional care. If you’re in
        crisis, call or text{' '}
        <a href="tel:988" class="underline underline-offset-4">
          988
        </a>
        .
      </p>
    </article>
  </Section>

  {related.length > 0 && (
    <Section tone="tint" spacing="sm" labelledby="related-heading">
      <div class="mx-auto max-w-2xl">
        <h2 id="related-heading" class="text-3xl">
          Keep reading
        </h2>
        <ul class="mt-6 border-t border-brand-900/20">
          {related.map((p) => (
            <li class="relative border-b border-brand-900/20 py-4">
              <a
                href={postPath(p)}
                class="font-display text-xl text-ink after:absolute after:inset-0 hover:text-brand-700"
              >
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Section>
  )}

  <CtaBand />
</BaseLayout>
