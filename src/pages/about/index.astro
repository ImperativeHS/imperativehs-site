---
import CtaBand from '@/components/sections/CtaBand.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema } from '@/lib/seo/structured-data';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

const values = [
  { title: 'Compassion', body: 'We approach every person with empathy, understanding, and kindness.' },
  {
    title: 'Integrity',
    body: 'We hold ourselves to the highest ethical standards and work to earn the trust of our clients and their families.',
  },
  {
    title: 'Collaboration',
    body: 'We work closely with clients, families, and other healthcare professionals to achieve the best possible outcomes.',
  },
  {
    title: 'Excellence',
    body: 'From clinical care to customer service, we are committed to excellence and continuous improvement.',
  },
  {
    title: 'Respect',
    body: 'We treat everyone with dignity, honoring each person’s experiences, perspectives, and background.',
  },
];
---

<BaseLayout
  title="About Us"
  description="Imperative Healthcare Services provides integrated outpatient mental health care and in-home residential support for individuals and families in Maryland."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Empowering families, youth, and individuals with hope, healing, and happiness"
    breadcrumbs={crumbs}
    kicker="About us"
  />

  <Section>
    <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <h2 class="text-3xl sm:text-4xl">Who we are</h2>
        <div class="mt-6 space-y-5 text-lg text-ink/90">
          <p>
            Imperative Healthcare Services provides compassionate, comprehensive care through two connected
            areas of focus: outpatient mental health services and in-home residential support.
          </p>
          <p>
            Our team includes licensed clinicians — psychiatric providers, therapists, and counselors —
            alongside trained, background-checked caregivers. Together, we support you through every step of
            your health journey, whether at our office, in the community, or at home.
          </p>
        </div>
      </div>
      <dl class="border-t border-line">
        <div class="border-b border-line py-7">
          <dt class="font-display text-2xl">Our mission</dt>
          <dd class="mt-3 text-muted">
            To facilitate hope, wellness, and personal growth for all individuals through integrated
            behavioral health support and compassionate residential care — in a safe, judgment-free
            environment that improves mental health and quality of life while maximizing independence.
          </dd>
        </div>
        <div class="border-b border-line py-7">
          <dt class="font-display text-2xl">Our vision</dt>
          <dd class="mt-3 text-muted">
            A community where mental health and residential support needs are prioritized, stigma is
            eliminated, and everyone can seek the right combination of services without fear of judgment or
            discrimination.
          </dd>
        </div>
      </dl>
    </div>
  </Section>

  <Section tone="tint" labelledby="values-heading">
    <SectionHeading id="values-heading" title="What we value" />
    <ol class="mt-12 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-5">
      {values.map((v, i) => (
        <li class="border-t border-brand-900/20 py-6">
          <span class="text-sm text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-2xl">{v.title}</h3>
          <p class="mt-2 text-[15px] text-muted">{v.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section labelledby="areas-heading" spacing="sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 id="areas-heading" class="text-2xl sm:text-3xl">
        Areas we serve
      </h2>
      <p class="text-lg text-ink">{site.serviceAreas.join(' · ')}</p>
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
