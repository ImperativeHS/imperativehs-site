---
import CtaBand from '@/components/sections/CtaBand.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { Image } from 'astro:assets';
import groupSession from '@/assets/images/site/group-session.jpg';
import ScreeningCallout from '@/components/sections/ScreeningCallout.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema } from '@/lib/seo/structured-data';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

const values = [
  { title: 'Compassion', body: 'We approach every person with empathy, understanding, and kindness.' },
  {
    title: 'Integrity',
    body: 'We hold ourselves to the highest ethical standards and work to earn the trust of our clients and their families.',
  },
  {
    title: 'Collaboration',
    body: 'We work closely with clients, families, and other healthcare professionals to achieve the best possible outcomes.',
  },
  {
    title: 'Excellence',
    body: 'From clinical care to customer service, we are committed to excellence and continuous improvement.',
  },
  {
    title: 'Respect',
    body: 'We treat everyone with dignity, honoring each person’s experiences, perspectives, and background.',
  },
];
---

<BaseLayout
  title="About Us"
  description="Imperative Healthcare Services provides integrated outpatient mental health care and in-home residential support for individuals and families in Maryland."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="About Us"
    tagline="Empowering families, youth, and individuals with hope, healing, and happiness."
    breadcrumbs={crumbs}
  />

  <section class="grid lg:grid-cols-[minmax(0,1fr)_2fr]" aria-labelledby="who-heading">
    <div class="flex flex-col justify-center px-5 py-14 sm:px-8 lg:py-20 lg:pr-12 lg:pl-[max(2rem,calc((100vw-1200px)/2+2rem))]">
      <SectionHeading id="who-heading" title="Who We Are" weight="light" />
      <p class="mt-6 text-lg font-light">
        Imperative Healthcare Services provides compassionate, comprehensive care through two connected areas
        of focus: outpatient mental health services and in-home residential support.
      </p>
      <p class="mt-4 text-lg font-light">
        Our team includes licensed clinicians — psychiatric providers, therapists, and counselors — alongside
        trained, background-checked caregivers. Together, we support you through every step of your health
        journey, whether at our office, in the community, or at home.
      </p>
    </div>
    <Image
      src={groupSession}
      alt="A counselor leading a group conversation"
      widths={[720, 960, 1400]}
      sizes="(min-width: 1024px) 66vw, 100vw"
      class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto lg:min-h-[560px]"
    />
  </section>

  <section class="grid text-center md:grid-cols-2" aria-label="Mission and vision">
    <div class="bg-purple px-8 py-16 text-white lg:px-20 lg:py-24">
      <h2 class="text-[34px] font-light tracking-[0.02em] sm:text-[40px]">Our Mission</h2>
      <span class="mx-auto mt-4 block h-[3px] w-12 bg-magenta" aria-hidden="true"></span>
      <p class="mt-6 text-lg font-light text-white/95">
        To facilitate hope, wellness, and personal growth for all individuals through integrated behavioral
        health support and compassionate residential care — in a safe, judgment-free environment that improves
        mental health and quality of life while maximizing independence.
      </p>
    </div>
    <div class="bg-white px-8 py-16 lg:px-20 lg:py-24">
      <h2 class="text-[34px] font-light tracking-[0.02em] text-sky sm:text-[40px]">Our Vision</h2>
      <span class="mx-auto mt-4 block h-[3px] w-12 bg-magenta" aria-hidden="true"></span>
      <p class="mt-6 text-lg font-light">
        A community where mental health and residential support needs are prioritized, stigma is eliminated,
        and everyone can seek the right combination of services without fear of judgment or discrimination.
      </p>
    </div>
  </section>

  <Section tone="cloud" labelledby="values-heading">
    <SectionHeading id="values-heading" title="Our Core Values" align="center" rule />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {values.map((v) => (
        <li class="border-t-4 border-magenta bg-white px-6 py-7 text-center shadow-[0_2px_12px_rgb(0_0_0/0.06)]">
          <h3 class="text-2xl font-medium text-purple">{v.title}</h3>
          <p class="mt-3 text-[15.5px]">{v.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section spacing="sm" labelledby="areas-heading">
    <div class="text-center">
      <h2 id="areas-heading" class="text-[30px] font-semibold text-magenta">
        Service Areas
      </h2>
      <span class="accent-rule mx-auto" aria-hidden="true"></span>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-10 gap-y-2 font-heading text-2xl font-light text-purple uppercase">
        {site.serviceAreas.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
    </div>
  </Section>

  <ScreeningCallout />
  <CtaBand />
</BaseLayout>
