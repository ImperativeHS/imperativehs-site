---
import PageHero from '@/components/sections/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noindex>
  <PageHero title="Page Not Found" />
  <Section spacing="lg">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-heading text-[30px] font-light text-magenta uppercase">We couldn’t find that page</p>
      <p class="mt-4 text-lg font-light">
        The page may have moved when we updated our website. Try one of these instead, or call us at{' '}
        <a href={site.phone.href} class="font-semibold text-sky-dark underline">
          {site.phone.display}
        </a>
        .
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" variant="purple">
          Home
        </Button>
        <Button href="/services/" variant="magenta">
          Our services
        </Button>
        <Button href="/request-appointment/" variant="sky">
          Schedule appointment
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
