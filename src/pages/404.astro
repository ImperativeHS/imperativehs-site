---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noindex>
  <Section spacing="lg">
    <div class="mx-auto max-w-xl text-center">
      <p class="kicker">Page not found</p>
      <h1 class="mt-4 text-5xl">We couldn’t find that page</h1>
      <p class="mt-4 text-lg text-muted">
        The page may have moved when we updated our website. Try one of these instead, or call us at{' '}
        <a href={site.phone.href} class="link">
          {site.phone.display}
        </a>
        .
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/">Home</Button>
        <Button href="/services/" variant="secondary">
          Services
        </Button>
        <Button href="/request-appointment/" variant="secondary">
          Request an appointment
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
