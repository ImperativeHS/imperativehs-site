---
import { Image } from 'astro:assets';
import headshot from '@/assets/images/faramade-eruanga.jpg';
import CtaBand from '@/components/sections/CtaBand.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ORG_ID, breadcrumbSchema } from '@/lib/seo/structured-data';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Our Team', path: '/team/' },
];

const credentials = [
  'Doctor of Nursing Practice (DNP) with honors, University of Massachusetts Global',
  'Dual board certification in psychiatric-mental health and family nursing',
  'Master’s in nursing, Maryville University',
  'Clinical experience in oncology, orthopedics, and pain management',
];
const focus = [
  'Psychiatric assessment',
  'Medication management',
  'Connection to therapy and counseling',
  'Complementary wellness approaches',
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Faramade Eruanga',
  honorificPrefix: 'Dr.',
  honorificSuffix: 'DNP, PMHNP-BC, FNP-C',
  jobTitle: 'Medical Director',
  worksFor: { '@id': ORG_ID },
  url: new URL('/team/', site.url).href,
};
---

<BaseLayout
  title="Our Team"
  description="Meet Dr. Faramade Eruanga, DNP, Medical Director of Imperative Healthcare Services, board certified in psychiatric-mental health and family nursing."
  jsonLd={[breadcrumbSchema(crumbs), personSchema]}
>
  <PageHero title="Our Team" breadcrumbs={crumbs} />

  <article class="grid lg:grid-cols-3">
    <div class="bg-purple px-8 py-14 text-white sm:px-14 lg:py-20">
      <h2 class="font-title text-[34px] leading-tight font-extrabold normal-case">Meet Our Provider</h2>
      <Image
        src={headshot}
        alt="Dr. Faramade Eruanga in a white coat"
        widths={[336, 672]}
        sizes="(min-width: 1024px) 336px, 90vw"
        class="mt-6 aspect-[3/4] w-full max-w-[336px] object-cover object-top"
      />
      <p class="mt-6 font-title text-xl font-bold text-magenta uppercase">Dr. Faramade Eruanga, DNP</p>
      <p class="font-title uppercase">Medical Director</p>
      <p class="mt-1 text-sm font-light text-white/80">DNP, PMHNP-BC, FNP-C</p>
    </div>

    <div class="px-8 py-14 sm:px-14 lg:py-20">
      <p class="text-lg font-light">
        Dr. Faramade (Fara) Eruanga is the medical director of Imperative Healthcare Services, bringing more
        than 15 years of mental health expertise to her compassionate practice. Her qualifications include:
      </p>
      <ul class="mt-5 list-disc space-y-2 pl-5 font-light marker:text-magenta">
        {credentials.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
      <p class="mt-6 text-lg font-light">
        After witnessing firsthand the barriers many people face in accessing affordable mental health care,
        Dr. Eruanga made it her mission to use her diverse medical background to help fill those gaps.
      </p>
      <h3 class="mt-8 text-2xl font-medium text-purple">Her Professional Approach</h3>
      <p class="mt-3 text-lg font-light">
        Dr. Eruanga believes mental health care should address the whole person — their background, values,
        and aspirations alongside clinical symptoms. She focuses on understanding root causes and nurturing
        lasting wellness rather than quick fixes.
      </p>
    </div>

    <div class="bg-blush px-8 py-14 sm:px-14 lg:py-20">
      <p class="text-lg font-light">
        At Imperative Healthcare Services, she has built a judgment-free environment where clients feel
        comfortable being themselves while working together on treatment plans that may include:
      </p>
      <ul class="mt-5 list-disc space-y-2 pl-5 font-light marker:text-magenta">
        {focus.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
      <h3 class="mt-8 text-2xl font-medium text-purple">What Sets Her Apart</h3>
      <p class="mt-3 text-lg font-light">
        Those who work with Dr. Eruanga highlight her empathy, compassion, and active listening. Her
        determination to help clients find their strengths and resilience leads to meaningful change.
      </p>
      <h3 class="mt-8 text-2xl font-medium text-purple">In Her Own Words</h3>
      <blockquote class="mt-3 border-l-4 border-magenta pl-5 text-lg font-light italic">
        “My goal is to provide a trusted home for mental health healing. We laugh together, cry together, and
        don’t give up on one another. I treat all my clients like family, walking side by side on their
        journey of growth.”
      </blockquote>
    </div>
  </article>

  <CtaBand showPhoto={false} />
</BaseLayout>
