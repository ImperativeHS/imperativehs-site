---
import PageHero from '@/components/sections/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You" description="We received your submission." noindex>
  <PageHero title="Thank You" />
  <Section spacing="lg">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-heading text-[30px] font-light text-magenta uppercase" data-thanks-title>
        We received your request
      </p>
      <span class="accent-rule mx-auto" aria-hidden="true"></span>
      <p class="mt-6 text-lg font-light" data-thanks-body>
        Our team will reach out soon using the contact method you chose. If you need to speak with someone
        sooner, please call us at{' '}
        <a href={site.phone.href} class="font-semibold text-sky-dark underline">
          {site.phone.display}
        </a>
        .
      </p>
      <p class="mt-8 border-l-4 border-magenta bg-blush p-5 text-left text-[15px]">
        If you are in crisis, call or text{' '}
        <a href={site.crisis.lifeline.href} class="font-semibold underline">
          988
        </a>{' '}
        any time. In an emergency, call{' '}
        <a href={site.crisis.emergency.href} class="font-semibold underline">
          911
        </a>
        .
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <Button href="/" variant="purple">
          Back to home
        </Button>
        <Button href="/services/" variant="magenta">
          Our services
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // Adjust the copy for general messages (the page is static, so this runs client-side).
  if (new URLSearchParams(location.search).get('form') === 'contact') {
    const title = document.querySelector('[data-thanks-title]');
    if (title) title.textContent = 'Your message was sent';
  }
</script>
