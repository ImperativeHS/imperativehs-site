---
import { Image } from 'astro:assets';
import logo from '@/assets/images/logo.png';
import headshot from '@/assets/images/faramade-eruanga.jpg';
import CtaBand from '@/components/sections/CtaBand.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import InsuranceList from '@/components/sections/InsuranceList.astro';
import ServiceList from '@/components/sections/ServiceList.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, servicePath } from '@/lib/content';
import { clinicSchema } from '@/lib/seo/structured-data';

const services = await getServices();

const facts = [
  { label: 'Insurance', value: 'Medicaid, Medicare, and most major plans', href: '/insurance/' },
  { label: 'Hours', value: 'Mon–Fri 9am–7pm, Saturdays by appointment' },
  { label: 'Who we see', value: 'Children, teens, adults, and families' },
  { label: 'Location', value: `${site.address.street}, ${site.address.city}`, href: site.mapsUrl },
];

const reasons = [
  {
    title: 'No judgment, ever',
    body: 'A safe, welcoming space where you’re heard and respected, whatever you’re facing.',
  },
  {
    title: 'Care for the whole family',
    body: 'Support for children, teens, adults, and parents, with services that work together.',
  },
  {
    title: 'Licensed and confidential',
    body: 'Licensed clinicians, a licensed Maryland RSA, and strict privacy standards under HIPAA.',
  },
  {
    title: 'Hours that fit your life',
    body: 'Evening appointments, Saturdays by appointment, and virtual sessions for many services.',
  },
];
---

<BaseLayout
  title="Imperative Healthcare Services | Mental Health Care in Hyattsville, MD"
  fullTitle
  jsonLd={[
    clinicSchema({
      logoUrl: logo.src,
      services: services.map((s) => ({ name: s.data.title, path: servicePath(s) })),
    }),
  ]}
>
  <section>
    <div class="container-page grid gap-12 pt-12 pb-16 sm:pt-16 lg:grid-cols-[1.35fr_1fr] lg:items-end lg:gap-16 lg:pt-20 lg:pb-20">
      <div class="lg:pb-6">
        <p class="kicker mb-6 animate-rise">Outpatient mental health care in {site.county}</p>
        <h1 class="animate-rise text-[2.9rem] leading-[1.02] [animation-delay:60ms] sm:text-7xl">
          Care that meets you <em class="text-brand-700">where you are.</em>
        </h1>
        <p class="mt-7 max-w-xl animate-rise text-lg text-muted [animation-delay:120ms] sm:text-xl">
          Therapy, psychiatric care, recovery support, and in-home services for individuals and families in
          Hyattsville, MD — offered with warmth and without judgment.
        </p>
        <div class="mt-9 flex animate-rise flex-col gap-3 [animation-delay:180ms] sm:flex-row sm:items-center sm:gap-6">
          <Button href="/request-appointment/" size="lg" icon="arrow-right" iconPosition="end">
            Request an appointment
          </Button>
          <a href={site.phone.href} class="link text-lg">
            or call {site.phone.display}
          </a>
        </div>
      </div>

      <figure class="animate-rise [animation-delay:120ms]">
        <Image
          src={headshot}
          alt="Dr. Faramade Eruanga, Medical Director"
          widths={[420, 640, 840]}
          sizes="(min-width: 1024px) 420px, 100vw"
          loading="eager"
          class="aspect-[5/4] w-full rounded-lg object-cover object-[50%_18%] sm:aspect-[16/10] lg:aspect-[4/5] lg:object-top"
        />
        <figcaption class="mt-3 flex justify-between gap-4 text-sm text-muted">
          <span>Dr. Faramade Eruanga, DNP</span>
          <span>Medical Director</span>
        </figcaption>
      </figure>
    </div>

    <div class="container-page">
      <dl class="grid border-y border-line sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((f, i) => (
          <div
            class:list={[
              'py-5 sm:px-6 sm:first:pl-0',
              i > 0 && 'border-t border-line sm:border-t-0',
              i % 2 === 1 && 'sm:border-l sm:border-line',
              i === 2 && 'sm:border-t lg:border-t-0 lg:border-l sm:pl-0 lg:pl-6',
              i === 3 && 'sm:border-t lg:border-t-0',
            ]}
          >
            <dt class="text-sm text-muted">{f.label}</dt>
            <dd class="mt-1 text-ink">
              {f.href ? (
                <a href={f.href} class="hover:text-brand-700">
                  {f.value}
                </a>
              ) : (
                f.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Section labelledby="services-heading">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        id="services-heading"
        title="How we can help"
        intro="Four connected programs, so you can get the right kind of support as your needs change."
      />
      <a href="/services/" class="link shrink-0">
        All services
      </a>
    </div>
    <div class="mt-12">
      <ServiceList />
    </div>
  </Section>

  <HowItWorks />

  <Section labelledby="why-heading">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <figure>
        <blockquote class="font-display text-3xl leading-snug text-brand-950 sm:text-4xl">
          “My goal is to provide a trusted home for mental health healing. We laugh together, cry together,
          and don’t give up on one another.”
        </blockquote>
        <figcaption class="mt-6 text-muted">
          Dr. Faramade Eruanga, Medical Director ·{' '}
          <a href="/team/" class="link">
            Meet our team
          </a>
        </figcaption>
      </figure>

      <div>
        <h2 id="why-heading" class="sr-only">
          Why families choose us
        </h2>
        <ul class="border-t border-line">
          {reasons.map((r) => (
            <li class="border-b border-line py-5">
              <h3 class="text-xl">{r.title}</h3>
              <p class="mt-1 text-muted">{r.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="tint" labelledby="insurance-heading">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <SectionHeading
          id="insurance-heading"
          title="Insurance we accept"
          intro="Don’t see your plan? Call us and we’ll help you check your coverage before your first visit."
        />
        <a href="/insurance/" class="link mt-6 inline-block">
          Insurance details
        </a>
      </div>
      <InsuranceList />
    </div>
  </Section>

  <Section labelledby="referral-heading" spacing="sm">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-2xl">
        <h2 id="referral-heading" class="text-2xl sm:text-3xl">
          Referring a client or loved one?
        </h2>
        <p class="mt-2 text-muted">
          Clinicians, case managers, schools, and families can refer someone to any of our programs.
        </p>
      </div>
      <Button href="/referrals/" variant="secondary" icon="arrow-right" iconPosition="end" class="shrink-0">
        Make a referral
      </Button>
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
