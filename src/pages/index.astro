---
import { Image } from 'astro:assets';
import logo from '@/assets/images/logo.png';
import headshot from '@/assets/images/faramade-eruanga.jpg';
import CtaBand from '@/components/sections/CtaBand.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import InsuranceList from '@/components/sections/InsuranceList.astro';
import ServiceCards from '@/components/sections/ServiceCards.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, servicePath } from '@/lib/content';
import { clinicSchema } from '@/lib/seo/structured-data';

const services = await getServices();

const reasons: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'heart',
    title: 'Judgment-free care',
    body: 'A safe, welcoming space where you’re heard and respected — whatever you’re facing.',
  },
  {
    icon: 'users',
    title: 'Care across the lifespan',
    body: 'Support for children, teens, adults, and families, with services that work together.',
  },
  {
    icon: 'shield-check',
    title: 'Licensed and confidential',
    body: 'Licensed clinicians, a licensed Maryland RSA, and strict privacy standards under HIPAA.',
  },
  {
    icon: 'calendar',
    title: 'Flexible options',
    body: 'Evening hours, Saturday appointments, and in-person or virtual sessions for many services.',
  },
];
---

<BaseLayout
  title="Imperative Healthcare Services | Mental Health Care in Hyattsville, MD"
  fullTitle
  jsonLd={[
    clinicSchema({
      logoUrl: logo.src,
      services: services.map((s) => ({ name: s.data.title, path: servicePath(s) })),
    }),
  ]}
>
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-brand-50/60 to-surface">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-40 -right-32 size-[32rem] rounded-full bg-brand-200/50 blur-3xl"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-40 -left-32 size-96 rounded-full bg-sky-brand-400/15 blur-3xl"
    ></div>

    <div class="container-page relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.25fr_1fr] lg:py-24">
      <div>
        <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm font-medium text-brand-700 ring-1 ring-brand-100">
          <Icon name="map-pin" class="size-4" />
          Hyattsville, MD · {site.county}
        </p>
        <h1 class="text-4xl font-semibold sm:text-5xl lg:text-6xl">
          Mental health care that meets you where you are
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted sm:text-xl">
          Compassionate outpatient mental health care, psychiatric rehabilitation, substance use treatment,
          and in-home support for individuals and families — without shame or judgment.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/request-appointment/" size="lg" icon="calendar">
            Request an appointment
          </Button>
          <Button href={site.phone.href} size="lg" variant="secondary" icon="phone">
            Call {site.phone.display}
          </Button>
        </div>
        <p class="mt-5 text-sm text-muted">
          Not sure where to start?{' '}
          <a
            href={site.screeningUrl}
            class="font-semibold text-brand-700 underline underline-offset-2 hover:text-brand-900"
          >
            Take a free, confidential 3-minute screening
          </a>
          .
        </p>
      </div>

      <aside class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-line" aria-label="At a glance">
        <ul class="space-y-5">
          <li class="flex gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
              <Icon name="shield-check" class="size-5" />
            </span>
            <div>
              <p class="font-semibold text-ink">Insurance accepted</p>
              <p class="text-sm text-muted">
                Medicaid, Medicare, CareFirst, Aetna, Cigna, UnitedHealthcare, and more.
              </p>
              <a
                href="/insurance/"
                class="mt-1 inline-block text-sm font-semibold text-brand-700 hover:underline"
              >
                See all plans
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
              <Icon name="clock" class="size-5" />
            </span>
            <div>
              <p class="font-semibold text-ink">Open late on weekdays</p>
              <p class="text-sm text-muted">Monday–Friday, 9am–7pm. Saturdays by appointment.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
              <Icon name="users" class="size-5" />
            </span>
            <div>
              <p class="font-semibold text-ink">Children, teens, and adults</p>
              <p class="text-sm text-muted">Individual, family, and group care for every stage of life.</p>
            </div>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <Section labelledby="services-heading">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        id="services-heading"
        eyebrow="Our services"
        title="Support for every step of your journey"
        intro="From therapy and medication management to community-based rehabilitation and in-home care."
      />
      <Button
        href="/services/"
        variant="secondary"
        icon="arrow-right"
        iconPosition="end"
        class="self-start sm:self-auto"
      >
        All services
      </Button>
    </div>
    <div class="mt-10">
      <ServiceCards />
    </div>
  </Section>

  <HowItWorks />

  <Section labelledby="why-heading">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeading
          id="why-heading"
          eyebrow="Why Imperative"
          title="Instilling hope through better access — without shame"
          intro="We’re here to help you face mental health challenges and get back to healthy living, with care that respects your background, beliefs, and goals."
        />
        <ul class="mt-10 grid gap-6 sm:grid-cols-2">
          {reasons.map((r) => (
            <li>
              <span class="flex size-10 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
                <Icon name={r.icon} class="size-5" />
              </span>
              <h3 class="mt-4 font-sans text-base font-semibold text-ink">{r.title}</h3>
              <p class="mt-1 text-sm text-muted">{r.body}</p>
            </li>
          ))}
        </ul>
      </div>

      <figure class="rounded-3xl bg-brand-50 p-6 ring-1 ring-brand-100 sm:p-8">
        <div class="flex items-center gap-5">
          <Image
            src={headshot}
            alt="Dr. Faramade Eruanga"
            widths={[96, 192]}
            sizes="96px"
            class="size-24 rounded-2xl object-cover object-top"
          />
          <figcaption>
            <p class="font-display text-xl font-semibold text-brand-900">Dr. Faramade Eruanga, DNP</p>
            <p class="text-sm text-muted">Medical Director</p>
          </figcaption>
        </div>
        <blockquote class="mt-6 font-display text-xl leading-relaxed text-brand-900 sm:text-2xl">
          “My goal is to provide a trusted home for mental health healing. We laugh together, cry together,
          and don’t give up on one another.”
        </blockquote>
        <a
          href="/team/"
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline"
        >
          Meet our team <Icon name="arrow-right" class="size-4" />
        </a>
      </figure>
    </div>
  </Section>

  <Section tone="tint" labelledby="insurance-heading">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <div>
        <SectionHeading
          id="insurance-heading"
          eyebrow="Insurance"
          title="We accept most major insurance"
          intro="Don’t see your plan? Call us — we’ll help you check your coverage before your first visit."
        />
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/insurance/" variant="secondary">
            Insurance details
          </Button>
          <Button href={site.phone.href} variant="ghost" icon="phone">
            {site.phone.display}
          </Button>
        </div>
      </div>
      <InsuranceList />
    </div>
  </Section>

  <Section labelledby="referral-heading" spacing="sm">
    <div class="flex flex-col gap-6 rounded-3xl p-7 ring-1 ring-line sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <div class="max-w-2xl">
        <h2 id="referral-heading" class="text-2xl font-semibold">
          Referring a client or loved one?
        </h2>
        <p class="mt-2 text-muted">
          Clinicians, case managers, schools, and families can refer someone to our mental health, PRP,
          substance use, or in-home care services.
        </p>
      </div>
      <Button href="/referrals/" icon="arrow-right" iconPosition="end" class="shrink-0">
        Make a referral
      </Button>
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
