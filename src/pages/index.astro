---
import { Image } from 'astro:assets';
import logo from '@/assets/images/logo.png';
import counseling from '@/assets/images/site/counseling-session.jpg';
import inHomeCare from '@/assets/images/site/in-home-care.jpg';
import supportGroup from '@/assets/images/site/support-group-hug.jpg';
import CtaBand from '@/components/sections/CtaBand.astro';
import ScreeningCallout from '@/components/sections/ScreeningCallout.astro';
import Button from '@/components/ui/Button.astro';
import CornerCard from '@/components/ui/CornerCard.astro';
import CurveDivider from '@/components/ui/CurveDivider.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, servicePath } from '@/lib/content';
import { clinicSchema } from '@/lib/seo/structured-data';

const services = await getServices();

const heroBlocks = [
  {
    title: 'Mental Health Services',
    image: counseling,
    alt: 'A counselor listening to a client during a therapy session',
    href: '/services/mental-health/',
    cta: 'Click here for mental health services',
    bg: 'bg-purple',
    rule: 'bg-magenta',
    button: 'magenta' as const,
  },
  {
    title: 'In-Home Care (RSA) Services',
    image: inHomeCare,
    alt: 'A caregiver helping an older woman at home',
    href: '/services/residential-services/',
    cta: 'Click here for RSA services',
    bg: 'bg-magenta',
    rule: 'bg-purple',
    button: 'purple' as const,
  },
];

const specialties = [
  {
    title: 'Psychiatric Evaluation',
    body: 'Our psychiatric providers conduct thorough evaluations to assess your mental health needs and develop personalized treatment plans.',
    href: '/services/mental-health/',
  },
  {
    title: 'Group, Family, and Individual Counseling',
    body: 'Our skilled therapists provide counseling in individual, group, and family settings, offering support, guidance, and practical coping strategies.',
    href: '/services/mental-health/',
  },
  {
    title: 'Psychiatric Rehabilitation Programs (PRP)',
    body: 'Rehabilitation and case management for children, adolescents, and adults, on-site and in the community, to help people reach their goals.',
    href: '/services/psychiatric-rehabilitation/',
  },
  {
    title: 'Substance Use Disorder Services',
    body: 'Trauma-informed, evidence-based support for teens and adults working toward recovery, and for the families who love them.',
    href: '/services/substance-use/',
  },
  {
    title: 'Licensed & Bonded RSA in Maryland',
    body: 'Our Residential Service Agency is fully licensed and bonded in Maryland, meeting all state requirements and standards of care.',
    href: '/services/residential-services/',
  },
  {
    title: 'Background-Checked, Compassionate Caregivers',
    body: 'All of our caregivers undergo thorough background checks and are chosen for their empathy, dedication, and respect.',
    href: '/services/residential-services/',
  },
  {
    title: 'Personalized, Goal-Oriented Care Plans',
    body: 'Individualized care plans built around your needs, preferences, and lifestyle to maximize independence and quality of life.',
    href: '/services/residential-services/',
  },
  {
    title: 'HIPAA-Compliant and Culturally Competent',
    body: 'We maintain strict privacy standards under HIPAA while delivering care that respects diverse cultural backgrounds, beliefs, and practices.',
    href: '/about/',
  },
];
---

<BaseLayout
  title="Imperative Healthcare Services | Mental Health Care in Hyattsville, MD"
  fullTitle
  jsonLd={[
    clinicSchema({
      logoUrl: logo.src,
      services: services.map((s) => ({ name: s.data.title, path: servicePath(s) })),
    }),
  ]}
>
  <!-- Split hero: the two halves of the practice -->
  <section class="grid md:grid-cols-2" aria-label="Our services">
    {heroBlocks.map((block, i) => (
      <div
        class:list={[
          'flex flex-col items-center px-5 py-10 text-center text-white sm:px-12 sm:py-14 lg:px-[72px] lg:py-[100px]',
          block.bg,
        ]}
      >
        <Image
          src={block.image}
          alt={block.alt}
          widths={[480, 720, 1000]}
          sizes="(min-width: 768px) 576px, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="aspect-[16/9] w-full object-cover"
        />
        <h2 class="mt-8 text-[32px] font-light tracking-[0.02em] sm:text-[36px]">{block.title}</h2>
        <span class:list={['mt-4 block h-[3px] w-12', block.rule]} aria-hidden="true"></span>
        <Button href={block.href} variant={block.button} size="lg" spaced class="mt-8 max-w-full">
          {block.cta}
        </Button>
      </div>
    ))}
  </section>

  <Section>
    <div class="text-center">
      <h1 class="text-[30px] font-light tracking-[0.02em] text-magenta sm:text-[38px]">
        Instilling hope through better access without shame.
      </h1>
      <p class="mx-auto mt-6 max-w-4xl text-lg font-light sm:text-xl sm:leading-[1.8]">
        We’re here to help you face mental health challenges and get back to healthy living. Our team offers
        outpatient therapy, psychiatric care, rehabilitation, recovery support, and in-home care for
        individuals and families in Hyattsville, MD.
      </p>
    </div>
  </Section>

  <!-- About us: text beside a full-bleed photo -->
  <section class="grid lg:grid-cols-[minmax(0,1fr)_2fr]" aria-labelledby="about-heading">
    <div class="flex flex-col justify-center px-5 py-14 sm:px-8 lg:py-20 lg:pr-12 lg:pl-[max(2rem,calc((100vw-1200px)/2+2rem))]">
      <SectionHeading id="about-heading" title="About Us" rule />
      <p class="mt-6 text-lg font-light">
        At Imperative Healthcare Services, we are dedicated to providing compassionate and comprehensive
        outpatient mental health care to individuals and families in our community. Our licensed clinicians
        are here to support you through every step of your mental health journey.
      </p>
      <div class="mt-8">
        <Button href="/about/" variant="purple" spaced>
          Learn more
        </Button>
      </div>
    </div>
    <Image
      src={supportGroup}
      alt="A woman hugging another member of a support group"
      widths={[720, 960, 1400]}
      sizes="(min-width: 1024px) 66vw, 100vw"
      class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto lg:min-h-[560px]"
    />
  </section>

  <!-- Who we are: three color columns -->
  <section aria-labelledby="who-heading" class="pt-16 sm:pt-20">
    <SectionHeading id="who-heading" title="Who We Are" align="center" class="mb-10" />
    <div class="grid text-center md:grid-cols-3">
      <div class="bg-purple px-8 py-14 text-white lg:px-14 lg:py-20">
        <h3 class="text-[32px] font-semibold sm:text-[38px]">Our Mission</h3>
        <span class="accent-rule mx-auto" aria-hidden="true"></span>
        <p class="mt-6 font-light text-white/95">
          To facilitate hope, wellness, and personal growth for all individuals through integrated behavioral
          health support and compassionate residential care, in a safe, judgment-free environment.
        </p>
        <Button href="/about/" variant="magenta" size="sm" icon="circle-check" class="mt-8">
          Learn more
        </Button>
      </div>
      <div class="bg-white px-8 py-14 lg:px-14 lg:py-20">
        <h3 class="text-[32px] font-semibold text-magenta sm:text-[38px]">What to Expect</h3>
        <span class="accent-rule mx-auto" aria-hidden="true"></span>
        <p class="mt-6 font-light">
          From your first call, you’ll be greeted with warmth and compassion by our team of licensed
          clinicians. We’ll learn what you’re looking for, check your insurance, and build a care plan with
          you, so you feel valued, heard, and respected.
        </p>
        <Button href="/request-appointment/" variant="purple" size="sm" icon="calendar-check" class="mt-8">
          Schedule appointment
        </Button>
      </div>
      <div class="bg-magenta px-8 py-14 text-white lg:px-14 lg:py-20">
        <h3 class="text-[32px] font-semibold sm:text-[38px]">Opening Hours</h3>
        <span class="accent-rule mx-auto" aria-hidden="true"></span>
        <p class="mt-6 text-lg">
          {site.hoursSummary.map((line) => (
            <span class="block">{line}</span>
          ))}
        </p>
        <p class="mt-6 font-light">
          {site.address.street}
          <br />
          {`${site.address.city}, ${site.address.region} ${site.address.postalCode}`}
        </p>
        <Button href={site.phone.href} variant="outline-white" size="sm" icon="phone" class="mt-8">
          {site.phone.display}
        </Button>
      </div>
    </div>
  </section>

  <ScreeningCallout />

  <Section spacing="sm" class="pb-16 sm:pb-20" labelledby="specialty-heading">
    <SectionHeading id="specialty-heading" title="Specialty Care Services" weight="light" bar />
    <ul class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {specialties.map((item) => (
        <li>
          <h3 class="text-[19px] font-semibold text-magenta-dark">
            <a href={item.href} class="hover:text-purple">
              {item.title}
            </a>
          </h3>
          <p class="mt-3 text-[15.5px] leading-[1.9]">{item.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <CurveDivider />

  <section class="bg-cloud py-16 sm:py-20" aria-label="Insurance and referrals">
    <div class="container-page grid gap-10 md:grid-cols-[1fr_auto_1fr] lg:gap-16">
      <CornerCard>
        <h2 class="text-[32px] font-medium text-magenta sm:text-[36px]">Insurance Accepted</h2>
        <p class="mt-4 text-lg font-light">
          We accept Medicaid, Medicare, and most major insurance plans, including CareFirst, Aetna, Cigna,
          UnitedHealthcare, and TRICARE.
        </p>
        <Button href="/insurance/" variant="purple" size="sm" class="mt-8 shadow-lg">
          Learn more
        </Button>
      </CornerCard>

      <div class="flex items-center justify-center gap-4 self-center md:flex-col" aria-hidden="true">
        <span class="h-px w-16 bg-purple md:h-24 md:w-px"></span>
        <span class="font-heading text-[28px] font-medium text-magenta">OR</span>
        <span class="h-px w-16 bg-purple md:h-24 md:w-px"></span>
      </div>

      <CornerCard>
        <h2 class="text-[32px] font-medium text-magenta sm:text-[36px]">Send Your Referrals</h2>
        <p class="mt-4 text-lg font-light">
          Everyone deserves compassionate support for their mental health. If you know someone who could
          benefit from our services, we encourage you to refer them to us.
        </p>
        <Button href="/referrals/" variant="purple" size="sm" class="mt-8 shadow-lg">
          Learn more
        </Button>
      </CornerCard>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
